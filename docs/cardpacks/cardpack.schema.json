              "jointEnergy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "gains": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "power",
                    "endurance",
                    "mental",
                    "intelligence",
                    "sense"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "const": 0
